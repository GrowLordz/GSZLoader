<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/btnToggle"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/ic_menu"
        android:background="@drawable/bg_toggle_btn"
        android:padding="12dp"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"/>

    <LinearLayout
        android:id="@+id/menuPanel"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="62dp"
        android:orientation="vertical"
        android:background="@drawable/bg_menu"
        android:padding="18dp"
        android:elevation="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GSZ MOD MENU"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#00D4AA"/>

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@drawable/bg_toggle_btn"
                android:padding="6dp"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/espRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="?android:attr/selectableItemBackground"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/espLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ESP"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"/>

                <View
                    android:id="@+id/espIndicator"
                    android:layout_width="44dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_toggle_off"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/aimbotRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/aimbotLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AIMBOT"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"/>

                <View
                    android:id="@+id/aimbotIndicator"
                    android:layout_width="44dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_toggle_off"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
