<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Toggle button (always visible) -->
    <ImageView
        android:id="@+id/btnToggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_menu"
        android:background="@drawable/bg_toggle_btn"
        android:padding="10dp"
        android:elevation="8dp"/>

    <!-- Menu panel (expand/collapse) -->
    <LinearLayout
        android:id="@+id/menuPanel"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:orientation="vertical"
        android:background="@drawable/bg_menu"
        android:padding="16dp"
        android:elevation="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GSZ MOD MENU"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#00D4AA"
            android:layout_marginBottom="12dp"/>

        <!-- ESP Toggle Row -->
        <LinearLayout
            android:id="@+id/espRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:background="?attr/selectableItemBackground"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ESP"
                android:textSize="14sp"
                android:textColor="#FFFFFF"/>

            <View
                android:id="@+id/espIndicator"
                android:layout_width="40dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_toggle_off"/>
        </LinearLayout>

        <!-- Aimbot Toggle Row -->
        <LinearLayout
            android:id="@+id/aimbotRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AIMBOT"
                android:textSize="14sp"
                android:textColor="#FFFFFF"/>

            <View
                android:id="@+id/aimbotIndicator"
                android:layout_width="40dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_toggle_off"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
